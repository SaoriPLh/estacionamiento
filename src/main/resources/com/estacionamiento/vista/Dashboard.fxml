<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.estacionamiento.controlador.DashboardController"
      styleClass="content-area" spacing="24">

    <!-- Encabezado -->
    <HBox alignment="CENTER_LEFT" spacing="12">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Panel de Control" styleClass="page-title"/>
            <Label fx:id="lblZona" text="Zona: —" styleClass="page-subtitle"/>
        </VBox>
        <Button text="⟳  Recargar" styleClass="btn-secondary" onAction="#recargar"/>
        <Button text="+  Registrar Entrada" styleClass="btn-primary" onAction="#abrirRegistroEntrada"/>
    </HBox>

    <!-- Stats -->
    <HBox spacing="16">
        <HBox styleClass="card-stat" spacing="12" alignment="CENTER_LEFT">
            <VBox styleClass="stat-icon-blue" alignment="CENTER" minWidth="44" minHeight="44">
                <Label text="🚗" style="-fx-font-size:20px;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Total Espacios" styleClass="stat-label"/>
                <Label fx:id="lblTotal" text="0" styleClass="stat-value"/>
            </VBox>
        </HBox>
        <HBox styleClass="card-stat" spacing="12" alignment="CENTER_LEFT">
            <VBox styleClass="stat-icon-green" alignment="CENTER" minWidth="44" minHeight="44">
                <Label text="✓" style="-fx-font-size:20px;-fx-text-fill:#16a34a;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Disponibles" styleClass="stat-label"/>
                <Label fx:id="lblDisponibles" text="0" styleClass="stat-value" style="-fx-text-fill:#16a34a;"/>
            </VBox>
        </HBox>
        <HBox styleClass="card-stat" spacing="12" alignment="CENTER_LEFT">
            <VBox styleClass="stat-icon-amber" alignment="CENTER" minWidth="44" minHeight="44">
               <Label text="⚠" style="-fx-font-size:20px;-fx-text-fill:black;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Ocupados" styleClass="stat-label"/>
                <Label fx:id="lblOcupados" text="0" styleClass="stat-value" style="-fx-text-fill:#dc2626;"/>
            </VBox>
        </HBox>
        <HBox styleClass="card-stat" spacing="12" alignment="CENTER_LEFT">
            <VBox styleClass="stat-icon-blue" alignment="CENTER" minWidth="44" minHeight="44">
                <Label text="★" style="-fx-font-size:20px;-fx-text-fill:#2563eb;"/>
            </VBox>
            <VBox spacing="4">
                <Label text="Pensión" styleClass="stat-label"/>
                <Label fx:id="lblPension" text="0" styleClass="stat-value" style="-fx-text-fill:#2563eb;"/>
            </VBox>
        </HBox>
    </HBox>

    <!-- Buscador por placa -->
    <VBox styleClass="card" spacing="12">
        <Label text="Buscar vehículo por placa" style="-fx-font-size:13px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"/>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscarPlaca" promptText="Ej. ABC-123..." HBox.hgrow="ALWAYS"
                       styleClass="text-field" onAction="#buscarPorPlaca"/>
            <Button text="Buscar" styleClass="btn-secondary" onAction="#buscarPorPlaca"/>
        </HBox>
        <!-- Panel resultado inline -->
        <VBox fx:id="panelResultadoBusqueda" spacing="8" visible="false" managed="false"
              style="-fx-background-color:#eff6ff;-fx-background-radius:8;-fx-padding:12;-fx-border-color:#bfdbfe;-fx-border-radius:8;-fx-border-width:1;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label fx:id="lblResultadoBusqueda" text="" style="-fx-font-weight:bold;-fx-font-size:13px;" HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnSalidaBusqueda" text="Registrar Salida" styleClass="btn-primary" onAction="#abrirSalidaDesdeBusqueda"/>
            </HBox>
        </VBox>
        <Label fx:id="lblErrorBusqueda" text="" visible="false" managed="false"
               style="-fx-text-fill:#dc2626;-fx-font-size:12px;"/>
    </VBox>

    <!-- Grid de espacios -->
    <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="16">
        <Label text="Espacios" style="-fx-font-size:16px;-fx-font-weight:bold;-fx-text-fill:#1e293b;"/>
        <ScrollPane VBox.vgrow="ALWAYS" fitToWidth="true" styleClass="scroll-pane">
            <FlowPane fx:id="flowEspacios" hgap="12" vgap="12" prefWrapLength="900"/>
        </ScrollPane>
    </VBox>

</VBox>
