<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.estacionamiento.controlador.RegistroEntradaController"
      style="-fx-background-color:white;"
      spacing="0"
      minWidth="560"
      maxWidth="560"
      VBox.vgrow="ALWAYS">

    <!-- ===== HEADER ===== -->
    <HBox style="-fx-background-color:#2563eb; -fx-padding:20 28 20 28;" spacing="14" alignment="CENTER_LEFT">
        <VBox alignment="CENTER"
              style="-fx-background-color:rgba(255,255,255,0.18); -fx-background-radius:10; -fx-min-width:44; -fx-min-height:44;">
            <Label text="+" style="-fx-font-size:26px; -fx-text-fill:white; -fx-font-weight:bold;"/>
        </VBox>
        <VBox spacing="3">
            <Label text="Registrar Entrada" style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white;"/>
            <Label text="Captura los datos del vehículo que ingresa"
                   style="-fx-font-size:12px; -fx-text-fill:rgba(255,255,255,0.75);"/>
        </VBox>
    </HBox>

    <!-- ===== BODY CON SCROLL ===== -->
    <ScrollPane fx:id="scrollPane"
                fitToWidth="true"
                VBox.vgrow="ALWAYS"
                style="-fx-background-color:white; -fx-background:white;"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED">

        <VBox spacing="16" style="-fx-padding:24;">

            <!-- Vehículo -->
            <VBox spacing="10"
                  style="-fx-background-color:#f8fafc; -fx-background-radius:10;
                         -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-border-width:1;
                         -fx-padding:16;">
                <Label text="Vehículo"
                       style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#2563eb;"/>
                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Placa *"/>
                        <TextField fx:id="txtPlaca" promptText="Ej. ABC-123" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Marca"/>
                        <HBox spacing="6">
                            <ComboBox fx:id="cmbMarca" promptText="Seleccionar marca" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="+" onAction="#abrirNuevaMarca"
                                    style="-fx-min-width:32; -fx-min-height:32; -fx-background-color:#2563eb; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:6; -fx-cursor:hand;"/>
                        </HBox>
                    </VBox>
                </HBox>
                <VBox spacing="5">
                    <Label text="Modelo (opcional)"/>
                    <TextField fx:id="txtModelo" promptText="Ej. Corolla 2022" maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <!-- Espacio -->
            <VBox spacing="10"
                  style="-fx-background-color:#f8fafc; -fx-background-radius:10;
                         -fx-border-color:#e2e8f0; -fx-border-radius:10; -fx-border-width:1;
                         -fx-padding:16;">
                <Label text="Espacio y Tarifa"
                       style="-fx-font-size:12px; -fx-font-weight:bold; -fx-text-fill:#2563eb;"/>
                <HBox spacing="14">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Espacio *"/>
                        <ComboBox fx:id="cmbEspacio" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Tarifa *"/>
                        <ComboBox fx:id="cmbTarifa" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
                <Spinner fx:id="spnHoras" min="1" max="24" initialValue="1"/>
            </VBox>

            <!-- Código acceso -->
            <VBox fx:id="panelCodigoAcceso" spacing="10"
                  visible="false" managed="false"
                  style="-fx-background-color:#eff6ff; -fx-padding:16;">
                <Label text="Código de acceso — pensión"/>
                <TextField fx:id="txtCodigoAcceso"/>
                <Label fx:id="lblCodigoStatus"/>
            </VBox>

            <!-- Cliente -->
            <VBox fx:id="panelCliente" spacing="10"
                  visible="false" managed="false"
                  style="-fx-background-color:#fefce8; -fx-padding:16;">
                <Label text="Cliente pensionado"/>
                <HBox spacing="8">
                    <ComboBox fx:id="cmbCliente" HBox.hgrow="ALWAYS"/>
                    <Button text="+ Nuevo" onAction="#abrirFormularioCliente"/>
                </HBox>
            </VBox>

            <!-- Error -->
            <Label fx:id="lblError" visible="false" managed="false"
                   style="-fx-text-fill:red;"/>

            <!-- Botones -->
            <HBox spacing="12" alignment="CENTER_RIGHT">
                <Button text="Cancelar" onAction="#cancelar"/>
                <Button text="Confirmar" onAction="#confirmar"/>
            </HBox>

        </VBox>
    </ScrollPane>

</VBox>