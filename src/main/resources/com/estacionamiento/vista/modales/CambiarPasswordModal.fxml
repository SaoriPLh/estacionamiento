<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.estacionamiento.controlador.CambiarPasswordModalController"
      styleClass="login-card" stylesheets="@styles/app.css"
      spacing="18" prefWidth="380">
    <padding><Insets top="24" right="28" bottom="24" left="28"/></padding>

    <Label text="Cambiar Contraseña" styleClass="login-title"/>

    <VBox spacing="5">
        <Label text="Contraseña actual" styleClass="form-label"/>
        <PasswordField fx:id="txtPassActual" promptText="Tu contraseña actual" styleClass="password-field"/>
    </VBox>
    <VBox spacing="5">
        <Label text="Nueva contraseña" styleClass="form-label"/>
        <PasswordField fx:id="txtNuevaPass" promptText="Mínimo 4 caracteres" styleClass="password-field"/>
    </VBox>
    <VBox spacing="5">
        <Label text="Confirmar contraseña" styleClass="form-label"/>
        <PasswordField fx:id="txtConfirmarPass" promptText="Repite la nueva contraseña" styleClass="password-field"/>
    </VBox>

    <Label fx:id="lblError" style="-fx-text-fill:#ef4444; -fx-font-size:13px;"
           visible="false" managed="false" wrapText="true"/>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Cancelar"  onAction="#onCancelar" styleClass="btn-secondary" prefWidth="120"/>
        <Button text="Guardar"   onAction="#onGuardar"  styleClass="btn-primary"   prefWidth="140"/>
    </HBox>
</VBox>
