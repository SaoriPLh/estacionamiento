<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.estacionamiento.controlador.CambiarPasswordController"
           styleClass="login-bg" stylesheets="@styles/app.css">

    <!-- Contenedor externo sin background para que el gradiente del StackPane se vea -->
    <VBox alignment="CENTER" spacing="24" maxWidth="420">

        <!-- Ícono superior -->
        <VBox alignment="CENTER" spacing="8">
            <StackPane styleClass="login-icon-box" alignment="CENTER" maxWidth="56" maxHeight="56">
                <Label text="🔒" style="-fx-text-fill:white; -fx-font-size:24px;"/>
            </StackPane>
            <Label text="Actualizar Contraseña" styleClass="login-title"/>
            <Label text="Por seguridad, debes cambiar tu clave temporal."
                   styleClass="login-subtitle" wrapText="true" textAlignment="CENTER" maxWidth="320"/>
        </VBox>

        <!-- Card blanca -->
        <VBox styleClass="login-card" spacing="18">
            <VBox spacing="5">
                <Label text="Nueva Contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtNuevaPass" promptText="Mínimo 4 caracteres" styleClass="password-field"/>
            </VBox>
            <VBox spacing="5">
                <Label text="Confirmar Contraseña" styleClass="form-label"/>
                <PasswordField fx:id="txtConfirmarPass" promptText="Repite la contraseña" styleClass="password-field"/>
            </VBox>

            <Label fx:id="lblError" style="-fx-text-fill:#ef4444; -fx-font-size:13px;"
                   visible="false" managed="false" wrapText="true"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-secondary" prefWidth="120"/>
                <Button text="Actualizar" onAction="#onCambiar" styleClass="btn-primary" prefWidth="140"/>
            </HBox>
        </VBox>

    </VBox>
</StackPane>